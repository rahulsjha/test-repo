+test('when every open request is snoozed, request is null and the reason says when one returns', async t => {
+  const call = await snoozedFixture(t, [
+    snooze('GD-1', 'urgent', '2026-11-03T08:00:00Z', '2026-11-03T11:00:00Z'),
